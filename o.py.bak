"""Render-ready Flask service for resolving vplink.in short links."""

import os
import time
import traceback
import uuid
from threading import Lock

from flask import Flask, request, jsonify
from flask_cors import CORS

# Note: bypass function should be synchronous or we'll handle it differently
try:
    from bypass import SUPPORTED, bypass_sync as bypass
except ImportError:
    # Fallback if bypass doesn't have sync version
    from bypass import SUPPORTED, bypass
    import asyncio

TIMEOUT = int(os.getenv("BYPASS_TIMEOUT", "420"))
CACHE_TTL = int(os.getenv("CACHE_TTL", "300"))
API_KEY = os.getenv("API_KEY", "").strip()

app = Flask(__name__)
CORS(app)

JOBS: dict[str, dict] = {}
RESULT_CACHE: dict[str, dict] = {}
JOB_LOCK = Lock()
CACHE_LOCK = Lock()

# Simple synchronous wrapper for bypass if it's async
def run_bypass_sync(url: str):
    """Run bypass synchronously."""
    try:
        # If bypass is async, run it in a new event loop
        if hasattr(bypass, '__call__') and asyncio.iscoroutinefunction(bypass):
            loop = asyncio.new_event_loop()
            asyncio.set_event_loop(loop)
            try:
                return loop.run_until_complete(bypass(url))
            finally:
                loop.close()
        else:
            return bypass(url)
    except Exception as e:
        raise e


def _error(message: str, code: int = 400, **extra):
    return jsonify({"success": False, "status": "error", "error": message, **extra}), code


def _normalize(value: str) -> str:
    value = value.strip().strip("\"'")
    if not value.startswith(("http://", "https://")):
        value = "https://" + value
    return value


def _check_key(key: str | None):
    if API_KEY and key != API_KEY:
        return _error("Invalid API key.", 403)
    return None


def _payload(job_id: str) -> dict:
    job = JOBS[job_id]
    result = {
        "success": job.get("success", False),
        "status": job.get("status", "running"),
        "source": job["source"],
        "job_id": job_id,
        "took": round(time.time() - job["started"], 1),
    }
    for key in ("bypassed", "error"):
        if key in job:
            result[key] = job[key]
    if result["status"] == "running":
        result["pending"] = True
        result["poll"] = f"/job?id={job_id}"
    return result


def _process_job(job_id: str, source: str):
    """Process job synchronously."""
    job = JOBS[job_id]
    try:
        destination = run_bypass_sync(source)
        with JOB_LOCK:
            job.update({"status": "done", "success": True, "bypassed": destination})
        with CACHE_LOCK:
            RESULT_CACHE[source] = {"bypassed": destination, "stored": time.time()}
    except TimeoutError:
        with JOB_LOCK:
            job.update({"status": "error", "success": False, "error": "Bypass timed out"})
    except Exception as error:
        traceback.print_exc()
        with JOB_LOCK:
            job.update(
                {"status": "error", "success": False, 
                 "error": f"{type(error).__name__}: {error}"}
            )
    finally:
        with JOB_LOCK:
            job["took"] = round(time.time() - job["started"], 1)


def _start(source: str):
    # Check cache first
    with CACHE_LOCK:
        cached = RESULT_CACHE.get(source)
        if cached and time.time() - cached["stored"] <= CACHE_TTL:
            return {
                "success": True,
                "status": "done",
                "source": source,
                "job_id": "cached",
                "took": 0,
                "bypassed": cached["bypassed"],
                "cached": True,
            }

    # Check if already running
    with JOB_LOCK:
        for job_id, job in JOBS.items():
            if job.get("source") == source and job.get("status") == "running":
                return _payload(job_id)

    # Create new job
    job_id = uuid.uuid4().hex[:12]
    with JOB_LOCK:
        JOBS[job_id] = {
            "source": source,
            "started": time.time(),
            "status": "running",
            "success": False,
        }

    # Process job synchronously (this will block but we handle it)
    _process_job(job_id, source)
    return _payload(job_id)


@app.route("/")
def info():
    return jsonify({
        "name": "Bypass API",
        "version": "2.1.0",
        "supported": SUPPORTED,
        "endpoints": ["/health", "/bypass", "/job", "/jobs"],
    })


@app.route("/health")
def health():
    return jsonify({"ok": True})


@app.route("/bypass", methods=["GET"])
def bypass_get():
    url = request.args.get("url")
    bypass_param = request.args.get("bypass")
    key = request.args.get("key")
    
    key_error = _check_key(key)
    if key_error:
        return key_error
    
    value = url or bypass_param
    if not value:
        return _error("Missing url. Use ?url=<shortlink>.", 422)
    
    result = _start(_normalize(value))
    return jsonify(result)


@app.route("/bypass", methods=["POST"])
def bypass_post():
    body = request.get_json() or {}
    key_error = _check_key(body.get("key"))
    if key_error:
        return key_error
    
    value = body.get("url") or body.get("bypass")
    if not value:
        return _error("Missing url in request body.", 422)
    
    result = _start(_normalize(value))
    return jsonify(result)


@app.route("/job")
def job_get():
    job_id = request.args.get("id")
    if not job_id or job_id not in JOBS:
        return _error("Unknown job id", 404)
    return jsonify(_payload(job_id))


@app.route("/jobs")
def jobs_get():
    with JOB_LOCK:
        jobs_list = [_payload(job_id) for job_id in list(JOBS)[-25:]]
    return jsonify({"jobs": jobs_list})


if __name__ == "__main__":
    port = int(os.getenv("PORT", "5000"))
    app.run(host="0.0.0.0", port=port, debug=False)